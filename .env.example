# ── Obligatorias ───────────────────────────────────────────────────────────────
# Contraseña de Postgres en docker compose (por defecto `postgres`, solo para desarrollo).
# Si la cambias, cámbiala también en DATABASE_URL.
POSTGRES_PASSWORD=postgres
# Fuera de Docker: localhost. Dentro de compose, docker-compose.yml la reemplaza por el host `db`.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/biblioteca_rag
# Generar: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# ── Opcionales (valor por defecto) ─────────────────────────────────────────────
APP_NAME=biblioteca-rag
DEBUG=false
LOG_LEVEL=INFO
# Orígenes que pueden llamar a la API desde un navegador (lista JSON).
# Vacía = ninguno: solo clientes del mismo origen o sin navegador. Ej: ["https://app.example.com"]
CORS_ORIGINS=[]

# ── Embeddings (bge-m3) ────────────────────────────────────────────────────────
# Proveedor activo: cloudflare | ollama
EMBEDDINGS_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_EMBEDDINGS_MODEL=@cf/baai/bge-m3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDINGS_MODEL=bge-m3

# ── LLM (respuesta redactada) ──────────────────────────────────────────────────
# Proveedor activo: minimax | ollama (ollama = prueba local, usa OLLAMA_BASE_URL)
LLM_PROVIDER=minimax
# llama3.2:3b: qwen3:4b ignora el modo sin razonamiento y devuelve su razonamiento como respuesta
OLLAMA_LLM_MODEL=llama3.2:3b
# MiniMax por su endpoint compatible con Anthropic.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/anthropic
MINIMAX_MODEL=MiniMax-M2.7-highspeed

# ── Pregunta ───────────────────────────────────────────────────────────────────
# Distancia coseno máxima para que un trozo cuente como relevante (calibrada con bge-m3 sobre
# las preguntas de oro; ver settings.py). Por encima, responde «no lo sé» sin llamar al LLM.
PREGUNTA_DISTANCIA_MAXIMA=0.55

# ── Ingesta en segundo plano y conectores ──────────────────────────────────────
# Fuera de Docker. En compose, docker-compose.yml los reemplaza por los servicios internos.
REDIS_URL=redis://localhost:6379
INGESTA_TEMPORAL=/tmp/biblioteca-rag/ingesta
# API de resume para la colección `sobre-mi` (conector «resume»). Vacía = desactivado.
RESUME_API_URL=
# Visión para páginas sin texto: ollama | ninguno
VISION_PROVIDER=ollama
OLLAMA_VISION_MODEL=moondream
# Solo Docker: dónde ve la API a Ollama (por defecto el servicio `ollama` del perfil homónimo).
# OLLAMA_URL_DOCKER=http://ollama:11434
